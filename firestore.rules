rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isBootstrappedAdmin() {
      return isSignedIn() &&
        request.auth.token.email == 'shahidnaeemrind@gmail.com' &&
        request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && (
        isBootstrappedAdmin() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['title', 'slug', 'productType', 'category', 'targetAudience', 'status']) &&
        data.keys().hasOnly([
          'title', 'slug', 'shortDescription', 'fullDescription', 'productType',
          'category', 'targetAudience', 'gradeRange', 'language', 'pages',
          'dimensions', 'binding', 'coverImage', 'additionalImages', 'parentPrice',
          'schoolPrice', 'originalPrice', 'discount', 'youtubeUrl', 'drivePdfUrl',
          'tableOfContents', 'learningOutcomes', 'minOrderQuantity', 'stockStatus',
          'featured', 'status', 'sortOrder', 'seoTitle', 'seoDescription',
          'createdAt', 'updatedAt'
        ]) &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
        data.slug is string && data.slug.size() > 0 && data.slug.size() <= 220 &&
        data.productType in ['individual', 'package'] &&
        data.category is string && data.category.size() <= 100 &&
        data.targetAudience in ['schools', 'parents', 'both'] &&
        data.status in ['draft', 'published'] &&
        (!('shortDescription' in data) || (data.shortDescription is string && data.shortDescription.size() <= 1000)) &&
        (!('fullDescription' in data) || (data.fullDescription is string && data.fullDescription.size() <= 15000)) &&
        (!('gradeRange' in data) || (data.gradeRange is string && data.gradeRange.size() <= 100)) &&
        (!('language' in data) || (data.language is string && data.language.size() <= 50)) &&
        (!('pages' in data) || (data.pages is string && data.pages.size() <= 50)) &&
        (!('dimensions' in data) || (data.dimensions is string && data.dimensions.size() <= 100)) &&
        (!('binding' in data) || (data.binding is string && data.binding.size() <= 100)) &&
        (!('coverImage' in data) || (data.coverImage is string && data.coverImage.size() <= 2500)) &&
        (!('additionalImages' in data) || (data.additionalImages is list && data.additionalImages.size() <= 10)) &&
        (!('parentPrice' in data) || (data.parentPrice is number && data.parentPrice >= 0)) &&
        (!('schoolPrice' in data) || (data.schoolPrice is number && data.schoolPrice >= 0)) &&
        (!('originalPrice' in data) || (data.originalPrice is number && data.originalPrice >= 0)) &&
        (!('discount' in data) || (data.discount is string && data.discount.size() <= 50)) &&
        (!('youtubeUrl' in data) || (data.youtubeUrl is string && data.youtubeUrl.size() <= 1500)) &&
        (!('drivePdfUrl' in data) || (data.drivePdfUrl is string && data.drivePdfUrl.size() <= 1500)) &&
        (!('tableOfContents' in data) || (data.tableOfContents is string && data.tableOfContents.size() <= 5000)) &&
        (!('learningOutcomes' in data) || (data.learningOutcomes is string && data.learningOutcomes.size() <= 5000)) &&
        (!('minOrderQuantity' in data) || (data.minOrderQuantity is number && data.minOrderQuantity >= 1)) &&
        (!('stockStatus' in data) || data.stockStatus in ['in_stock', 'pre_order', 'out_of_stock']) &&
        (!('featured' in data) || data.featured is bool) &&
        (!('sortOrder' in data) || data.sortOrder is number) &&
        (!('seoTitle' in data) || (data.seoTitle is string && data.seoTitle.size() <= 200)) &&
        (!('seoDescription' in data) || (data.seoDescription is string && data.seoDescription.size() <= 500));
    }

    function isValidSettings(data) {
      return data.keys().hasAll(['brandName', 'whatsappNumber']) &&
        data.brandName is string && data.brandName.size() <= 100 &&
        data.whatsappNumber is string && data.whatsappNumber.size() <= 50 &&
        (!('tagline' in data) || (data.tagline is string && data.tagline.size() <= 200)) &&
        (!('establishedYear' in data) || (data.establishedYear is string && data.establishedYear.size() <= 20)) &&
        (!('address' in data) || (data.address is string && data.address.size() <= 300)) &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 50)) &&
        (!('email' in data) || (data.email is string && data.email.size() <= 100)) &&
        (!('announcement' in data) || (data.announcement is string && data.announcement.size() <= 500));
    }

    function isValidSeoSettings(data) {
      return data.keys().hasAll(['titlePrefix', 'defaultDescription']) &&
        data.keys().hasOnly([
          'titlePrefix', 'defaultDescription', 'faviconUrl', 'keywords',
          'ogImageUrl', 'googleVerification', 'updatedAt'
        ]) &&
        data.titlePrefix is string && data.titlePrefix.size() > 0 && data.titlePrefix.size() <= 100 &&
        data.defaultDescription is string && data.defaultDescription.size() > 0 && data.defaultDescription.size() <= 500 &&
        (!('faviconUrl' in data) || (data.faviconUrl is string && data.faviconUrl.size() <= 2000)) &&
        (!('keywords' in data) || (data.keywords is string && data.keywords.size() <= 500)) &&
        (!('ogImageUrl' in data) || (data.ogImageUrl is string && data.ogImageUrl.size() <= 2000)) &&
        (!('googleVerification' in data) || (data.googleVerification is string && data.googleVerification.size() <= 200));
    }

    // Products collection rules
    match /products/{productId} {
      allow get: if isValidId(productId) && (resource.data.status == 'published' || isAdmin());
      allow list: if (resource.data.status == 'published') || isAdmin();
      allow create: if isAdmin() && isValidId(productId) && isValidProduct(incoming());
      allow update: if isAdmin() && isValidId(productId) && isValidProduct(incoming()) &&
                    (!('createdAt' in existing()) || incoming().createdAt == existing().createdAt);
      allow delete: if isAdmin() && isValidId(productId);
    }

    // Company and SEO Settings
    match /settings/{settingId} {
      allow get, list: if isValidId(settingId);
      allow write: if isAdmin() && isValidId(settingId) && (
        (settingId == 'company' && isValidSettings(incoming())) ||
        (settingId == 'seo' && isValidSeoSettings(incoming()))
      );
    }

    // Admins registry
    match /admins/{uid} {
      allow read, write: if isAdmin() && isValidId(uid);
    }
  }
}
